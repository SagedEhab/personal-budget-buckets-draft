# Copy to .env (git-ignored) for local runs. Never commit the real .env.
# Generate a secret with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-64-random-hex-characters
CORS_ORIGINS=http://localhost:8080
GATEWAY_PORT=3000
FRONTEND_PORT=8080
# Keeps local data between restarts (folder is git-ignored). Remove to use memory only.
LOCAL_DATA_DIR=.local-data
# Optional: first admin for scripts/seed-admin.js (set in your shell, not here)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
